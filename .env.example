# ===========================================================
# NutriSync - Environment Configuration
# ===========================================================
# Copia este archivo como .env y completa los valores.
# ¡NUNCA subas el .env real al repositorio!
# ===========================================================

# ─── Feature Flag: Firebase vs Backend propio ─────────────
# El cambio se hace en: lib/core/config/app_config.dart
# Busca la línea: static const bool useFirebase = true;
#
# true  = Usa Firebase (FirebaseAuth, Firestore, FCM)
# false = Usa backend propio (API con Dio)
#
# Cuando el backend esté listo:
#   1. Cambia useFirebase a false en app_config.dart
#   2. Implementa ApiClient con la URL de abajo
#   3. Crea los datasources remotos usando Dio

